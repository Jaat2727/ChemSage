<Window
    x:Class="ChemSAGE_WinUI.AppShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ChemSAGE_WinUI.Models"
    Title="ChemSAGE">
    <Grid>
        <NavigationView x:Name="RootNavigation" PaneDisplayMode="Auto" IsBackButtonVisible="Visible" SelectionChanged="OnSelectionChanged" BackRequested="OnBackRequested">
            <NavigationView.Header>
                <TextBlock Text="ChemSAGE Desktop" Style="{StaticResource TitleTextBlockStyle}" />
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="Resource Vault" Tag="resource-vault" Icon="Library" />
                <NavigationViewItem Content="Past Papers" Tag="past-papers" Icon="Document" />
                <NavigationViewItem Content="Study Circles" Tag="study-circles" Icon="People" />
                <NavigationViewItem Content="Tasks" Tag="tasks" Icon="Calendar" />
                <NavigationViewItem Content="Profile" Tag="profile" Icon="Contact" />
                <NavigationViewItem Content="Admin Panel" Tag="admin-panel" Icon="Admin" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
