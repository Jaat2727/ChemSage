<Page x:Class="ChemSAGE_WinUI.Views.AdminPanelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}">
            <Border Background="{StaticResource ChemSagePanelBrush}" Padding="24" CornerRadius="12">
                <StackPanel Spacing="16">
                    <TextBlock Text="Admin Panel" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Desktop view synchronized with the same Supabase tables and database functions used by the web application." TextWrapping="Wrap" Opacity="0.75" />
                    <StackPanel Spacing="10"><TextBlock Text="Admin database functions" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="{Binding Stats.ActiveUsers}"/><TextBlock Text="Orphan users"/><ListView ItemsSource="{Binding OrphanUsers}" DisplayMemberPath="Email"/></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
