<Page x:Class="ChemSAGE_WinUI.Views.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48" MaxWidth="520">
        <StackPanel Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="Sign in to ChemSAGE" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBox Header="Email" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox Header="Password" PasswordChanged="OnPasswordChanged" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <Button Content="Login" Command="{Binding SignInCommand}" HorizontalAlignment="Stretch" />
            <Button Content="Send password reset" Command="{Binding RequestPasswordResetCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
