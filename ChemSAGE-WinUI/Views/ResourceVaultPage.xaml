<Page x:Class="ChemSAGE_WinUI.Views.ResourceVaultPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="using:ChemSAGE_WinUI.Components">
    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Resource Vault" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Search, filter, upload, and download ChemSAGE resources backed by Supabase Storage." Opacity="0.75" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <components:SearchBar Text="{Binding SearchText, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Header="Course" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse, Mode=TwoWay}" PlaceholderText="All" />
                <ComboBox Grid.Column="2" Header="Semester" ItemsSource="{Binding Semesters}" SelectedItem="{Binding SelectedSemester, Mode=TwoWay}" PlaceholderText="All" />
                <ComboBox Grid.Column="3" Header="Type" ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding SelectedResourceType, Mode=TwoWay}" PlaceholderText="All" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Apply" Command="{Binding LoadCommand}" />
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource ChemSagePanelBrush}" Padding="16" CornerRadius="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Header="Upload title" Text="{Binding UploadTitle, Mode=TwoWay}" PlaceholderText="Defaults to file name" />
                    <TextBox Grid.Column="1" Header="Course" Text="{Binding UploadCourse, Mode=TwoWay}" />
                    <TextBox Grid.Column="2" Header="Semester" Text="{Binding UploadSemester, Mode=TwoWay}" />
                    <ComboBox Grid.Column="3" Header="Type" ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding UploadResourceType, Mode=TwoWay}" />
                    <Button Grid.Column="4" Content="Upload" Command="{Binding UploadCommand}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <components:LoadingView Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding TransferProgress}" />
                <Grid Grid.Row="2">
                    <components:EmptyStateView DataContext="{Binding EmptyState}" Visibility="{Binding IsResourceListEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ListView ItemsSource="{Binding Resources}" Visibility="{Binding HasResources, Converter={StaticResource BoolToVisibilityConverter}}" SelectedItem="{Binding SelectedResource, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate><DataTemplate><components:ResourceCard /></DataTemplate></ListView.ItemTemplate>
                </ListView>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                    <Button Content="Download selected" Command="{Binding DownloadSelectedCommand}" />
                    <components:ErrorView DataContext="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
