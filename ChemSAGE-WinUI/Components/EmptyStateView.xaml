<UserControl x:Class="ChemSAGE_WinUI.Components.EmptyStateView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="24" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="12">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="No records found" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
